[workspace]
resolver = "2"
members = []

[workspace.package]
edition      = "2024"
rust-version = "1.85"
# Fill in per consumer:
#   version      = "0.1.0"
#   license      = "MIT"
#   repository   = "https://github.com/<owner>/<repo>"
#   homepage     = "https://github.com/<owner>/<repo>"
#   authors      = ["<you> <you@example.com>"]

[profile.dev]
# Windows MSVC link.exe hits PDB LIMIT (LNK1318) once the dependency
# tree gets big (axum + sqlx + reqwest + jsonwebtoken + tokio-cron-
# scheduler + tracing all carry many monomorphisations on the same
# workspace). Line-tables-only debug info keeps backtraces useful
# while keeping the PDB inside the linker's per-record limit on
# Windows. No effect on Linux / macOS builds.
debug = "line-tables-only"

[workspace.dependencies]
# Shared dependency pins. Member crates declare them with
#   foo = { workspace = true }
# so version bumps happen in one place.
#
# This workspace's OWN crates belong here too, not in the member
# manifests. A published member that another member depends on needs a
# `version` as well as a `path` — crates.io has to resolve the
# requirement for somebody who is not building from this checkout:
#
#   my-core = { path = "crates/my-core", version = "0.1.0" }
#
# That literal does not follow `[workspace.package] version`, so a
# release bumps both. It fails late when you forget: the requirement is
# a caret, so a stale pin keeps resolving through every patch release
# and stops only at the first bump that crosses the minor — with
# `candidate versions found which didn't match`, in the middle of
# cutting the release. Keeping them here makes that one place instead
# of one per member; the README carries the test that stops them
# drifting from it.
